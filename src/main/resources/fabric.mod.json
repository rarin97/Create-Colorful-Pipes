{
  "schemaVersion": 1,
  "id": "colorfulpipes",
  "version": "${version}",
  "name": "Create: Colorful Pipes",
  "description": "adds colored variants of pipes & tanks for Create",
  "authors": [
    "Rarin"
  ],
  "contact": {
    "sources": "https://github.com/rarin97/Create-Colorful-Pipes"
  },
  "license": "MIT",
  "icon": "assets/colorfulpipes/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rarin.colorfulpipes.ColorfulPipes"
    ],
    "client": [
      "net.rarin.colorfulpipes.ColorfulPipesClient"
    ],
    "fabric-datagen": [
      "net.rarin.colorfulpipes.ColorfulPipesDatagen"
    ]
  },
  "mixins": [
    "ColorfulPipes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version_range}",
    "minecraft": "${minecraft_version}"
  }
}
